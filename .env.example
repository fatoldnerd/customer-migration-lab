# Copy to .env.local. All variables are optional: the app runs locally with none set.
# Server-only: never prefix these with NEXT_PUBLIC_.

# "simulated" (default) or "gemini"
AI_PROVIDER=
# Required only when AI_PROVIDER=gemini
GOOGLE_GEMINI_API_KEY=
# Any currently available Gemini model that accepts images (default: gemini-2.5-flash)
GEMINI_MODEL=

# Per-attempt provider timeout in ms (default 15000, keep below route maxDuration of 30 s)
ANALYSIS_TIMEOUT_MS=
# Total attempts for transient provider errors (default 2)
ANALYSIS_MAX_ATTEMPTS=
# Maximum decoded image size in bytes (default 3145728 = 3 MB, ≈ 4 MB base64)
ANALYSIS_MAX_IMAGE_BYTES=
# Artificial latency added to simulated responses, in ms (default 0)
SIMULATED_LATENCY_MS=
# Set to "disabled" to ignore fault-injection requests (default enabled, for the demo)
FAULT_INJECTION=
